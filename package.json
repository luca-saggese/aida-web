{
  "name": "gotraxx-aida-console-clone",
  "version": "1.0.0",
  "private": true,
  "description": "A clean-room reimplementation of the GoTraxx AI / Aida console.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace server",
    "test:e2e": "npm run test:e2e --workspace client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "npm run build --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.70.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=18"
  }
}
