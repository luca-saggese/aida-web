NODE_ENV=development

PORT=4000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/gotraxx-clone

# External inference server. The payload and response use the Aida SystemOne contract.
INFERENCE_API_URL=http://work.gotraxx.com:8082/v1/systemone
INFERENCE_API_KEY=
INFERENCE_API_TIMEOUT_MS=30000

API_KEY_PEPPER=change-me-to-a-long-random-string

MOCK_GOTRAXX=false

# Local (estimate) pricing per million tokens.
AIDA_INPUT_USD_PER_MILLION=0.042
AIDA_OUTPUT_USD_PER_MILLION=0

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
EMAIL_VERIFY_TOKEN_EXPIRES=24h
PASSWORD_RESET_TOKEN_EXPIRES=1h

# SMTP (optional in dev; tokens returned inline when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gotraxx-clone.local

# Email confirmation required
REQUIRE_EMAIL_CONFIRMATION=false